{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "J-Link Flash & Debug",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/PGV_RotateStand_FW.elf",
            "device": "STM32F103RE",
            "interface": "swd",
            "runToEntryPoint": "main",
            "svdFile": "${workspaceFolder}/stm32f103.svd",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "serverArgs": [
                "-speed", "1000",
                "-autoconnect", "1"
            ],
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "clearSearch": false,
                "decoders": [
                    {
                        "port": 0,
                        "type": "console"
                    }
                ]
            }
        }
    ]
}